{
  "manifestVersion": 5,
  "id": "com.prismex.editor",
  "name": "Prismex AI Editor",
  "version": "1.0.0",
  "main": "index.html",
  "host": [
    {
      "app": "premierepro",
      "minVersion": "24.0.0"
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "com.prismex.editor.panel",
      "label": {
        "default": "Prismex AI Editor"
      },
      "minimumSize": {
        "width": 380,
        "height": 550
      },
      "preferredDockedSize": {
        "width": 420,
        "height": 800
      }
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": [
        "http://127.0.0.1:49152",
        "ws://127.0.0.1:49152",
        "http://localhost:49152",
        "ws://localhost:49152"
      ]
    },
    "localFileSystem": "request",
    "allowExecution": true
  },
  "icons": [
    {
      "value": "assets/icons/icon-light.png",
      "size": 32
    },
    {
      "value": "assets/icons/icon-dark.png",
      "size": 32
    }
  ]
}
